# AUTON.MAX — PME + Pessoal
PORT=3000

# LLM (pelo menos um)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=

# Google OAuth (opcional — auth e Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_API_KEY=
DISABLE_GOOGLE_AUTH=true

# Runtime
AUTON_INTEGRITY_SECRET=change-me-in-production

# Dono do PME (alerta quando WA precisa de QR / fica offline)
OWNER_WHATSAPP_JID=

# Higiene de disco (dias para apagar replay/metrics antigos)
HYGIENE_MAX_AGE_DAYS=14

# URL pública no Render (keep-alive)
# RENDER_EXTERNAL_URL=https://seu-servico.onrender.com
